# Copy to .env and fill in real values. .env is gitignored; this template is tracked.
# EXPO_PUBLIC_* vars are embedded in the client bundle — only put publishable keys here.

# Supabase
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Mapbox — PUBLIC access token (pk.…). Embedded in the client to load map tiles.
# Create at https://account.mapbox.com/access-tokens/ with the default public scopes.
EXPO_PUBLIC_MAPBOX_ACCESS_TOKEN=pk.your-token-here

# Mapbox — SECRET download token (sk.…). Used ONLY at native build time by the
# @rnmapbox/maps config plugin to fetch the iOS/Android SDK. It is NOT an
# EXPO_PUBLIC var, is never shipped in the bundle, and must never be committed.
# Create a token with the DOWNLOADS:READ scope at
# https://account.mapbox.com/access-tokens/
RNMAPBOX_MAPS_DOWNLOAD_TOKEN=sk.your-secret-download-token-here

# RevenueCat (public SDK API key)
EXPO_PUBLIC_REVENUECAT_API_KEY=
